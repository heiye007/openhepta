{
  "name": "open-hepta",
  "version": "0.1.0",
  "license": "MIT",
  "author": "OpenHepta Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/heiye007/openhepta.git"
  },
  "homepage": "https://github.com/heiye007/openhepta#readme",
  "bugs": {
    "url": "https://github.com/heiye007/openhepta/issues"
  },
  "description": "High-performance, local-first visual knowledge OS with infinite whiteboards and card notes.",
  "keywords": [
    "heptabase",
    "whiteboard",
    "knowledge-management",
    "local-first",
    "electron",
    "prosemirror",
    "sqlite",
    "mindmap",
    "pdf-reader",
    "epub-reader"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "app-builder-lib>@electron/get": "3.1.0"
    }
  },
  "main": "dist-electron/electron-main/main.js",
  "bin": {
    "app": "./cli/openhepta-cli.mjs",
    "openhepta": "./cli/openhepta-cli.mjs"
  },
  "scripts": {
    "cli": "node cli/openhepta-cli.mjs",
    "dev:renderer": "cross-env VITE_CJS_IGNORE_WARNING=true vite",
    "build:renderer": "cross-env VITE_CJS_IGNORE_WARNING=true vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev": "concurrently -k \"cross-env VITE_CJS_IGNORE_WARNING=true vite\" \"tsc -p tsconfig.electron.json && node cli/dev-electron.mjs\"",
    "build": "cross-env VITE_CJS_IGNORE_WARNING=true vite build && tsc -p tsconfig.electron.json",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:linux": "pnpm build && electron-builder --linux",
    "check:arch": "node lint-rules/check-architecture.mjs",
    "lint": "eslint --max-warnings 0 electron-main electron-renderer shared && node lint-rules/check-architecture.mjs",
    "test:db": "tsx electron-main/database/__tests__/testDb.ts",
    "verify:tla": "node tla/run-tlc.mjs"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "better-sqlite3": "^13.0.3",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.16.0",
    "pdfjs-dist": "^6.5.438",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "26.18.0",
    "eslint": "^10.15.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.3.4"
  },
  "build": {
    "appId": "com.openhepta.app",
    "productName": "OpenHepta",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "dist-electron/electron-main/database/**/*"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenHepta"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Office",
      "target": [
        "AppImage"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "heiye007",
      "repo": "openhepta"
    }
  }
}